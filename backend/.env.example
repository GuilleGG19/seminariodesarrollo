# Copiar como backend/.env y completar. Generar secretos con: npm run secretos
NODE_ENV=development
PORT=3000

DB_HOST=localhost
DB_PORT=5432
DB_USER=sccvi_admin
DB_PASSWORD=
DB_NAME=sccvi_db

FRONTEND_URL=http://localhost:5173

# Minimo 32 caracteres aleatorios
JWT_SECRET=

# Cifrado de datos personales (AES-256-GCM) y hash para buscar por DPI.
# 64 caracteres hexadecimales cada una. NO cambiarlas despues de cifrar datos.
DATA_ENCRYPTION_KEY=
DATA_HASH_KEY=

# Numero de proxies delante del backend (0 en local, 1 detras de nginx/balanceador)
TRUST_PROXY=0

# Peticiones permitidas por IP cada 15 minutos en toda la API
RATE_LIMIT_GENERAL=1000

# Documentacion Swagger en /api/docs (por defecto activa fuera de produccion)
DOCS_ENABLED=true

# --- Correo ---
# Se usa Resend si RESEND_API_KEY tiene valor; si no, SMTP; si ninguno, se simula en consola.

# Resend (https://resend.com -> API Keys). Permiso "Sending access" basta.
RESEND_API_KEY=
# Remitente. Debe ser de un dominio verificado en Resend. Para pruebas sin dominio:
# "SCCVI <onboarding@resend.dev>" (solo entrega al correo con el que creaste la cuenta de Resend)
EMAIL_FROM="SCCVI Centro de Salud <alertas@tu-dominio.com>"
# Opcional: a donde llegan las respuestas de los padres
EMAIL_REPLY_TO=

# SMTP (alternativa a Resend)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="SCCVI Centro de Salud <no-responder@sccvi.local>"

# --- Telegram (opcional). Token del bot creado con @BotFather ---
TELEGRAM_BOT_TOKEN=
