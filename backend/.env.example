# Copiar como backend/.env y completar. Generar secretos con: npm run secretos
NODE_ENV=development
PORT=3000

DB_HOST=localhost
DB_PORT=5432
DB_USER=sccvi_admin
DB_PASSWORD=
DB_NAME=sccvi_db

FRONTEND_URL=http://localhost:5173

# Minimo 32 caracteres aleatorios
JWT_SECRET=

# Cifrado de datos personales (AES-256-GCM) y hash para buscar por DPI.
# 64 caracteres hexadecimales cada una. NO cambiarlas despues de cifrar datos.
DATA_ENCRYPTION_KEY=
DATA_HASH_KEY=

# Numero de proxies delante del backend (0 en local, 1 detras de nginx/balanceador)
TRUST_PROXY=0

# Peticiones permitidas por IP cada 15 minutos en toda la API
RATE_LIMIT_GENERAL=1000

# Documentacion Swagger en /api/docs (por defecto activa fuera de produccion)
DOCS_ENABLED=true

# --- Correo (SMTP). Si SMTP_HOST esta vacio, los correos se simulan en consola ---
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="SCCVI Centro de Salud <no-responder@sccvi.local>"

# --- Telegram (opcional). Token del bot creado con @BotFather ---
TELEGRAM_BOT_TOKEN=
